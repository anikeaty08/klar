# Set these in Hostinger hPanel → Web App → Environment variables. Do not commit .env.local.
RESEND_API_KEY=
CONTACT_TO=hello@klardatalabs.com,projects@klardatalabs.com,team@klardatalabs.com
# The single address used as Reply-To for optional visitor confirmation emails.
CONTACT_REPLY_TO=hello@klardatalabs.com
CONTACT_FROM=KlarDataLabs Website <website@klardatalabs.com>
CONTACT_AUTOREPLY=false
IPINFO_TOKEN=
TURNSTILE_SECRET_KEY=
# Include your final Hostinger domain(s); comma-separated, no protocol.
TURNSTILE_HOSTNAMES=klardatalabs.com,www.klardatalabs.com

# Public, baked into the Vite build. Set this before building if Turnstile is enabled.
VITE_TURNSTILE_SITE_KEY=
